# Service Configuration
PROJECT_NAME="flyio-ai-llm"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"
# "json": one JSON object per line, for log aggregators / cross-service
# request_id tracing. "text": readable single-line key=value, easier to
# skim in a local terminal — try it if you're developing locally and find
# JSON noisy to read directly.
LOG_FORMAT="json"

# Service-to-service Auth
#
# The shared key this service requires on every /v1/api/* request, in the
# X-Service-API-Key header (/health and /v1/health are public, so a healthy
# service says nothing about whether this is set correctly).
#
# It must equal LLM_SERVICE_API_KEY in the flyio-admin environment — that is
# the client side of this same pair. Note this is a SEPARATE key from the one
# flyio-scraper-service uses for its own SERVICE_API_KEY: admin holds one key
# per target and the two are not interchangeable.
#
# Empty by default, which rejects every authenticated request.
SERVICE_API_KEY=""

# LLM Provider Configuration
# Supported providers: mock, openai, groq
# LLM_API_KEY is your OpenAI API key when LLM_PROVIDER=openai — ignored for mock.
#
# groq: reuses the OpenAI-compatible client pointed at Groq's API
# (https://console.groq.com/docs/openai) — free tier, no separate provider
# code needed. Get a key at https://console.groq.com. Example:
#   LLM_PROVIDER="groq"
#   LLM_API_KEY="gsk_..."
#   LLM_MODEL="openai/gpt-oss-120b"
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# Embedding Provider Configuration
# Supported providers: mock, openai, local
# EMBEDDING_API_KEY is your OpenAI API key when EMBEDDING_PROVIDER=openai
# (can be the same key as LLM_API_KEY) — ignored for mock/local.
#
# local: runs a model on-box via fastembed (ONNX runtime) — no API key, no
# network call per request, no cost.
#
# EMBEDDING_DIMENSION MUST match BOTH the model's real output size AND the
# Qdrant collection's configured vector size. A mismatch is rejected by
# Qdrant at write time ("Vector dimension error: expected dim: X, got Y"), so
# changing the model means recreating the collection.
#   BAAI/bge-base-en-v1.5                      -> 768   (default; best size/quality trade-off)
#   sentence-transformers/all-MiniLM-L6-v2     -> 384   (smaller/faster, lower quality)
#   mixedbread-ai/mxbai-embed-large-v1         -> 1024  (best local quality)
#   text-embedding-3-small (openai)            -> 1536  (paid)
EMBEDDING_PROVIDER="mock"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="BAAI/bge-base-en-v1.5"
EMBEDDING_DIMENSION=768

# Qdrant Vector Database Configuration
#
# ALWAYS include an explicit port. The Qdrant Python client does NOT infer 443
# from an https:// URL — it falls back to Qdrant's default 6333 and the
# connection silently fails, even though the same URL works fine in curl
# (which does default to 443). For a hosted HTTPS instance use:
#   QDRANT_URL="https://your-instance.example.com:443"
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="flyio_knowledge_base"
# 0.45 suits the local embedding provider (measured: a genuinely relevant
# query/passage pair scores ~0.54 with it); raise toward 0.70 if you switch
# EMBEDDING_PROVIDER back to openai, which reports higher absolute cosine
# similarity for related pairs.
QDRANT_SEARCH_SCORE_THRESHOLD=0.45

# Database / Event Tracking
# No default in code (see app/core/config.py) — event tracking cleanly disables
# itself if this is left blank, rather than silently pointing at a credential
# that looks real. Fill in your actual Postgres DSN, e.g.:
#   postgresql://<user>:<password>@<host>:5432/<database>
DATABASE_ENABLED=true
DATABASE_URL=

