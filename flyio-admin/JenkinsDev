// Run this job on the Docker host shared with Nginx Proxy Manager.
// Required: Docker CLI, Python 3, Credentials Binding plugin, an existing
// NPM proxy host/certificate, and both containers on DOCKER_NETWORK.
pipeline {
    agent { label 'docker-flyio-eu-1' }
    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    parameters {
        string(name: 'DOCKER_NETWORK', defaultValue: 'nginx-proxy-manager', description: 'Existing Docker network attached to NPM on this Docker host.')
        string(name: 'NPM_URL', defaultValue: 'https://npm-domain.flyio.ai', description: 'NPM management URL with /api reachable.')
        string(name: 'NPM_CREDENTIAL_ID', defaultValue: 'NPM_CREDENTIAL', description: 'Jenkins username/password credential: NPM email and password.')
    }
    environment {
        CLEANUP_SERVICE = 'admin-dev'
        SERVICE_DOMAIN = 'dev-admin.flyio.ai'
        IMAGE_NAME = 'flyio-admin'
        UPLOAD_VOLUME = 'flyio-admin-dev-uploads'
    }
    stages {
        stage('Checkout and preflight') {
            steps {
                checkout scm
                script {
                    // Job hash prevents collisions with build numbers in other jobs.
                    env.RELEASE = sh(returnStdout: true, script: '''python3 -c 'import hashlib,os; print("dev-" + hashlib.sha256(os.environ["JOB_NAME"].encode()).hexdigest()[:8] + "-" + os.environ["BUILD_NUMBER"])' ''').trim()
                    env.CANDIDATE = "admin-${env.RELEASE}"
                    env.IMAGE_TAG = "${env.IMAGE_NAME}:${env.RELEASE}"
                }
                sh '''
                    set -eu
                    docker info >/dev/null
                    docker network inspect "$DOCKER_NETWORK" >/dev/null
                    python3 --version
                '''
                withCredentials([usernamePassword(credentialsId: params.NPM_CREDENTIAL_ID, usernameVariable: 'NPM_USERNAME', passwordVariable: 'NPM_PASSWORD')]) {
                    sh 'python3 scripts/deploy_dev.py preflight'
                }
            }
        }
        stage('Build image') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    sh 'docker build --tag "$IMAGE_TAG" .'
                }
            }
        }
        stage('Start candidate') {
            steps {
                withCredentials([file(credentialsId: 'env-dev-flyio-admin', variable: 'ENV_FILE')]) {
                    sh '''
                        set +x
                        set -eu
                        docker volume create --label flyio.environment=dev "$UPLOAD_VOLUME" >/dev/null
                        docker run --detach --name "$CANDIDATE" \
                            --network "$DOCKER_NETWORK" --restart unless-stopped \
                            --label flyio.service=admin-dev \
                            --label "flyio.build=$BUILD_NUMBER" \
                            --env-file "$ENV_FILE" \
                            --env PORT=3000 --env NODE_ENV=production \
                            --env BLOG_UPLOAD_DIR=/app/uploads/blog \
                            --mount "type=volume,source=$UPLOAD_VOLUME,target=/app/uploads/blog" \
                            "$IMAGE_TAG"
                    '''
                }
            }
        }
        stage('Check candidate') {
            steps {
                sh 'python3 scripts/deploy_dev.py check'
            }
        }
        stage('Switch NPM and verify') {
            steps {
                withCredentials([usernamePassword(credentialsId: params.NPM_CREDENTIAL_ID, usernameVariable: 'NPM_USERNAME', passwordVariable: 'NPM_PASSWORD')]) {
                    sh 'python3 scripts/deploy_dev.py promote'
                }
            }
        }
        stage('Clean old development releases') {
            steps {
                // Cleanup failure must not roll back the healthy deployment.
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    withCredentials([usernamePassword(credentialsId: params.NPM_CREDENTIAL_ID, usernameVariable: 'NPM_USERNAME', passwordVariable: 'NPM_PASSWORD')]) {
                        sh 'python3 scripts/cleanup_dev.py'
                    }
                }
            }
        }
    }
    post {
        success {
            echo 'Deployment verified. Older development releases cleaned up; volumes preserved.'
        }
        unsuccessful {
            // Do not delete a candidate: an interrupted NPM update may already
            // have routed traffic to it. The helper rolls back ordinary failures.
            echo 'Check failed/unstable stages and NPM upstream. Cleanup may be incomplete; volumes are preserved.'
        }
    }
}
