# ─── PostgreSQL ───────────────────────────────────────────────
PGHOST=your-postgres-host
PGPORT=5432
PGUSER=your-db-user
PGPASSWORD=your-db-password
PGDATABASE=your-db-name
# OR use a connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Admin Auth ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CMS_JWT_SECRET=your-strong-jwt-secret

# Bootstrap first admin (remove after first run)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=your-strong-password

# ─── Scraper Service ──────────────────────────────────────────
SCRAPER_SERVICE_URL=https://your-scraper-service.fly.dev
SCRAPER_SERVICE_API_KEY=your-scraper-api-key

# ─── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Polling (optional — defaults shown) ─────────────────────
# SCRAPER_POLL_INTERVAL_MS=5000
# SCRAPER_JOB_TIMEOUT_MS=300000

# ─── Blog (optional — defaults shown) ────────────────────────
# Directory for banner image uploads (default: ./uploads/blog)
# BLOG_UPLOAD_DIR=./uploads/blog
# CKEditor toolbar items, comma-separated (default: heading,|,bold,italic,link,bulletedList,numberedList,|,blockQuote,insertTable,undo,redo)
# CKEDITOR_TOOLBAR=heading,|,bold,italic,link,bulletedList,numberedList,|,blockQuote,insertTable,undo,redo

# ─── LLM Service (flyio-ai-llm) ──────────────────────────────
LLM_SERVICE_URL=http://localhost:8000
# Required — the service refuses to start without it.
#
# Admin is a client of two servers and holds one key per target. These are two
# independent pairs and are NOT interchangeable:
#
#   SCRAPER_SERVICE_API_KEY  must equal  SERVICE_API_KEY in flyio-scraper-service
#   LLM_SERVICE_API_KEY      must equal  SERVICE_API_KEY in flyio-ai-llm
#
# Setting one to the other's value produces a 401 that names the wrong service.
LLM_SERVICE_API_KEY=your-llm-service-api-key

# Chunks per POST /v1/api/store call when ingesting a page into the vector DB.
# The LLM service embeds a whole request before answering and the proxy in
# front of it closes idle connections after ~90s, so a large page must be sent
# in batches or the call fails after the points were already stored.
# LLM_STORE_BATCH_SIZE=10
# DEFAULT_SOURCE_URLS=https://en.wikipedia.org/wiki/Tourism_in_France

