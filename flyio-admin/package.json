{
  "name": "flyio-admin",
  "version": "1.0.0",
  "description": "flyio-admin — CMS, Blog, Trips, Knowledge Base admin + async scraper integration",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build:frontend": "npm run build --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:scraper": "cmd /c \"cd ..\\flyio-scraper-service\\flyio-scraper-service && python -m uvicorn src.main:app --port 8080 --reload\"",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:frontend\" \"npm run dev:scraper\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.13.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "concurrently": "^10.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
