# ════════════════════════════════════════════════════════
#  flyio-scraper-service — environment variables
#  Copy this file to .env and fill in real values locally.
#  On Fly.io use: fly secrets set KEY=value
#  NEVER commit .env with real values.
# ════════════════════════════════════════════════════════

# ── Service-to-service auth ──────────────────────────────
# Shared secret checked on every /scrape/* request.
# flyio-admin must send this in the X-Service-API-Key header.
SERVICE_API_KEY=change-me-before-deploying

# ── Tourism sources (for POST /scrape/sources) ───────────
# JSON array of source config dicts matching the shape in
# legacy_crawler/config.py SOURCES.
# If empty or unset, falls back to the 6 defaults in config.py:
#   Wikivoyage, TourMyIndia, Holidify, Thrillophilia, TravelTriangle, IncredibleIndia
# Example override (single source):
# TOURISM_SOURCES_JSON=[{"name":"Wikivoyage","strategy":"mediawiki_api","api_base":"https://en.wikivoyage.org/w/api.php","seed_titles":["India"],"max_pages":5}]
TOURISM_SOURCES_JSON=

# ── Crawler tuning ───────────────────────────────────────
# Defaults match travel_pipeline/config.py values.
# Override here to tune without rebuilding the image.
CRAWL4AI_HEADLESS=true
CRAWL4AI_PAGE_TIMEOUT_MS=45000
CRAWL4AI_WAIT_UNTIL=domcontentloaded
CRAWL4AI_MAX_CONCURRENT=3
REQUEST_TIMEOUT=20
MAX_RETRIES=4
REQUEST_DELAY_SECONDS=2.0
REQUEST_DELAY_JITTER=1.0
RESPECT_ROBOTS_TXT=true

# ── Destination discovery (for POST /scrape/discover) ────
# Turns a destination name into candidate URLs to crawl, so the knowledge
# base can be built without anyone pasting links by hand.
#
# Provider — one, or several comma-separated whose results are merged.
#   FREE, no API key:
#     wikimedia   Wikivoyage + Wikipedia search API. Official and stable.
#                 The default — works with no other setting.
#     duckduckgo  Web-wide, via the ddgs library. Unofficial: can be
#                 rate-limited, especially from cloud/datacenter IPs.
#     searxng     Web-wide, via a SearXNG instance you run yourself:
#                   docker run -d -p 8888:8080 searxng/searxng
#                 then add `json` under search.formats in its settings.yml.
#   PAID, need SEARCH_API_KEY:  tavily, brave
#   TESTS ONLY:  mock  (synthetic results, no network)
#
# Recommended free setup: wikimedia,duckduckgo — Wikimedia is the reliable
# core; DuckDuckGo adds breadth, and if it is throttled you still get the
# Wikimedia results (the failure is reported, not fatal).
#
# Check it before running anything:  python scripts/try_discovery.py Jabalpur
SEARCH_PROVIDER=wikimedia,duckduckgo
SEARCH_API_KEY=
SEARXNG_URL=
# Wikimedia asks clients to identify themselves; add a contact if you can,
# e.g. "flyio-scraper-service/1.0 (https://your-site.example)".
SEARCH_USER_AGENT=flyio-scraper-service/1.0 (travel destination discovery)
SEARCH_REGION=in-en

# Hits requested per expansion query (5 queries are run per destination).
DISCOVERY_RESULTS_PER_QUERY=5

# Hard ceiling on URLs returned for one destination. Each one costs a page
# load, a parse, and an embedding call per chunk downstream — this is the
# main cost control for the automated path.
DISCOVERY_MAX_URLS=12

# Max candidates from any single site, so one domain cannot take every slot
# and the topic spread across the 5 queries survives.
DISCOVERY_MAX_PER_DOMAIN=3

# Extra domains to never crawl, comma-separated. Merged with the built-in
# denylist (Pinterest, Quora, Reddit, social, OTA booking funnels).
DISCOVERY_DENIED_DOMAINS=
